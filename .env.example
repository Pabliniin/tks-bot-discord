# ─────────────────────────────────────────────────────────────
#  TK$ BOT — Variables de entorno
#  Copia este archivo a `.env` y rellena los valores.
# ─────────────────────────────────────────────────────────────

# ── Discord (https://discord.com/developers/applications) ────
DISCORD_TOKEN=tu_token_del_bot
DISCORD_CLIENT_ID=id_de_la_aplicacion
DISCORD_CLIENT_SECRET=secreto_de_la_aplicacion
# ID de tu servidor de pruebas (despliegue instantáneo de comandos)
DISCORD_DEV_GUILD_ID=
# IDs de los dueños del bot, separados por comas
BOT_OWNERS=

# ── Base de datos ────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/tkbot

# ── API interna (bot <-> panel) ──────────────────────────────
# Interfaz donde escucha la API interna.
#   127.0.0.1  -> bot y web en la misma maquina (por defecto, lo mas seguro)
#   0.0.0.0    -> en Docker/Easypanel, para que el contenedor de la web la alcance
BOT_API_HOST=127.0.0.1
BOT_API_PORT=3001
BOT_API_URL=http://127.0.0.1:3001
# Cadena larga y aleatoria. Genera una con: openssl rand -hex 32
BOT_API_SECRET=cambia_esto_por_una_cadena_aleatoria_larga

# Registra los comandos de barra automaticamente al arrancar el bot.
# Util en Docker/Easypanel, donde no hay terminal para lanzar el despliegue.
AUTO_DEPLOY_COMMANDS=false

# Avisos de errores a un canal privado de Discord (opcional pero MUY recomendable
# en produccion: sin esto no te enteras de que algo falla).
# Crealo en Ajustes del canal -> Integraciones -> Webhooks.
ERROR_WEBHOOK_URL=

# Etiqueta para distinguir esta instancia en los avisos y en el aviso de
# instancias duplicadas. Ejemplos: local, easypanel, pruebas.
INSTANCE_LABEL=

# ── Panel web ────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BOT_NAME=TK$ Bot
# Callback de OAuth2. Debe coincidir EXACTAMENTE con el de Discord Developers.
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback
# Firma de las cookies de sesión. Genera una con: openssl rand -hex 32
SESSION_SECRET=cambia_esto_por_otra_cadena_aleatoria_larga

# ── Enlaces públicos (footer del sitio) ──────────────────────
NEXT_PUBLIC_SUPPORT_INVITE=https://discord.gg/
NEXT_PUBLIC_TWITTER_URL=https://twitter.com/
NEXT_PUBLIC_TOPGG_URL=https://top.gg/

# ── Musica (Lavalink) ────────────────────────────────────────
# El audio lo procesa Lavalink, un servicio aparte. Es OPCIONAL: sin esto
# todo lo demas funciona y los comandos de musica explican que falta.
#
# Con docker-compose se levanta solo. En Easypanel hay que crear el servicio
# a mano: las instrucciones estan en MUSICA.md
#
# Direccion del servidor. Con Docker es el nombre del servicio.
#   docker-compose : lavalink:2333
#   Easypanel      : tuproyecto_lavalink:2333
#   En tu PC       : localhost:2333
LAVALINK_HOST=
# Debe coincidir con la del servidor Lavalink.
LAVALINK_PASSWORD=
# true solo si Lavalink esta detras de HTTPS. Por red interna va en false.
LAVALINK_SECURE=false
# Memoria en MB para Lavalink. 512 aguanta bien varios servidores a la vez.
LAVALINK_MEMORY=512

# ── Pagos (Stripe) ───────────────────────────────────────────
# OPCIONAL. Sin esto la pagina de premium sigue funcionando, pero sin
# botones de compra: el premium se reparte a mano con /premiumuser add.
#
# Instrucciones completas en PAGOS.md
#
# Clave secreta. Empieza por sk_test_ (pruebas) o sk_live_ (real).
# NUNCA la pongas en el navegador ni la subas a GitHub.
STRIPE_SECRET_KEY=
# Secreto del webhook. Empieza por whsec_. Lo da Stripe al crear el webhook.
# Sin esto no se puede verificar quien ha pagado de verdad.
STRIPE_WEBHOOK_SECRET=
#
# Identificadores de precio de Stripe. Empiezan por price_
# Se crean en Stripe -> Catalogo de productos.
STRIPE_PRICE_TIER1_MENSUAL=
STRIPE_PRICE_TIER1_ANUAL=
STRIPE_PRICE_TIER2_MENSUAL=
STRIPE_PRICE_TIER2_ANUAL=
