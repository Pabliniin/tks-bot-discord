# Normalización de finales de línea.
#
# Sin esto, al clonar el repositorio en otro equipo git podría convertir los
# .bat a LF y dejarían de funcionar: cmd.exe necesita CRLF o la ventana se
# abre y se cierra al instante.

# Por defecto, git decide.
* text=auto

# Windows: siempre CRLF.
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Linux: siempre LF, aunque se editen desde Windows.
*.sh    text eol=lf
Dockerfile text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# Binarios: que git no los toque.
*.png   binary
*.jpg   binary
*.ttf   binary
*.otf   binary
*.ico   binary
